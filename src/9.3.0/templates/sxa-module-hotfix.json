{
    "Parameters": {
        "Package": {
            "Type": "string",
            "Description": "The path to the Sitecore module package zip to convert and deploy.",
            "DefaultValue": ""
        },
        "SqlDbPrefix": {
            "Type": "string",
            "Description": "The prefix used for all Sql databases.",
            "DefaultValue": ""
        },
        "SiteName": {
            "Type": "string",
            "DefaultValue": "Sitecore",
            "Description": "The name of the site to be deployed."
        },
        "SqlAdminUser": {
            "Type": "string",
            "DefaultValue": "sa",
            "Description": "The Sql admin user account to use when installing databases."
        },
        "SqlAdminPassword": {
            "Type": "string",
            "DefaultValue": "12345",
            "Description": "The Sql admin password to use when installing databases."
        },
        "SqlServer": {
            "Type": "string",
            "DefaultValue": ".\\SQLSERVER",
            "Description": "The Sql Server where databases will be installed."
        },
        "SatToolsPath": {
            "Type": "string",
            "DefaultValue": ".\\lib\\sat\\tools",
            "Description": "The path of the Sitecore Azure Toolkit tools folder used to convert the module package."
        }
    },
    "Register": {
        "Tasks": {
            "RemoveItem": "Remove-Item"
        }
    },
    "Variables": {
        "Sql.Database.Core": "[concat(parameter('SqlDbPrefix'), '_Core')]",
        "Sql.Database.Master": "[concat(parameter('SqlDbPrefix'), '_Master')]",
        "SXA.DB.Core": "[SqlConnectionString(Server:parameter('SqlServer'),Database:variable('Sql.Database.Core'),UserName:parameter('SqlAdminUser'),Password:parameter('SqlAdminPassword'))]",
        "SXA.DB.Master": "[SqlConnectionString(Server:parameter('SqlServer'),Database:variable('Sql.Database.Master'),UserName:parameter('SqlAdminUser'),Password:parameter('SqlAdminPassword'))]",
        "Convert.Directory": "[joinpath(environment('TEMP'), concat(parameter('SiteName'), '.module-hotfix'))]",
        "Convert.Package": "[joinpath(variable('Convert.Directory'), 'module.scwdp.zip')]"
    },
    "Modules": [
        ".\\templates\\module-hotfix.psm1"
    ],
    "Tasks": {
        "CleanConvertLocation": {
            "Description": "Creates (or empties) the temp folder the module package is converted in.",
            "Type": "EnsurePath",
            "Params": {
                "Clean": [ "[variable('Convert.Directory')]" ]
            }
        },
        "ConvertModulePackage": {
            "Description": "Converts the module package to a Web Deploy package.",
            "Type": "ConvertSitecoreModule",
            "Params": {
                "Path": "[resolvepath(parameter('Package'))]",
                "SatToolsPath": "[resolvepath(parameter('SatToolsPath'))]",
                "Destination": "[variable('Convert.Directory')]"
            }
        },
        "StopWebsite": {
            "Description": "Stops the website if it is running.",
            "Type": "ManageWebsite",
            "Params": {
                "Name": "[parameter('SiteName')]",
                "Action": "Stop"
            }
        },
        "StopAppPool": {
            "Description": "Stops the app pool if it is running.",
            "Type": "ManageAppPool",
            "Params": {
                "Name": "[parameter('SiteName')]",
                "Action": "Stop"
            }
        },
        "InstallWDP": {
            "Description": "Syncs the web deploy package with the website.",
            "Type": "WebDeploy",
            "Params": {
                "Verb": "Sync",
                "Arguments": {
                    "Source": {
                        "Package": "[variable('Convert.Package')]"
                    },
                    "Dest": "Auto",
                    "enableRule": "DoNotDeleteRule",
                    "SetParam": [
                        { "Name": "Application Path", "Value": "[parameter('SiteName')]" },
                        { "Name": "Core Admin Connection String", "Value": "[variable('SXA.DB.Core')]" },
                        { "Name": "Master Admin Connection String", "Value": "[variable('SXA.DB.Master')]" }
                    ]
                }
            }
        },
        "StartAppPool": {
            "Description": "Starts the app pool.",
            "Type": "ManageAppPool",
            "Params": {
                "Name": "[parameter('SiteName')]",
                "Action": "Start"
            }
        },
        "StartWebsite": {
            "Description": "Starts the website.",
            "Type": "ManageWebsite",
            "Params": {
                "Name": "[parameter('SiteName')]",
                "Action": "Start"
            }
        },
        "CleanupConvertLocation": {
            "Description": "Cleans up the conversion temp folder after deployment.",
            "Type": "RemoveItem",
            "Params": {
                "Path": "[variable('Convert.Directory')]",
                "Recurse": true,
                "Force": true
            }
        }
    }
}
