<?xml version="1.0"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly xdt:Locator="Condition(_defaultNamespace:assemblyIdentity/@name='Newtonsoft.Json')">
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" xdt:Transform="SetAttributes(oldVersion)" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
