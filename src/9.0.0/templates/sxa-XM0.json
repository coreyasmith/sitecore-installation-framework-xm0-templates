{
    "Parameters": {
        "Package": {
            "Type": "string",
            "Description": "The path to the Web Deploy package to deploy.",
            "DefaultValue": ""
        },
        "SqlDbPrefix": {
            "Type": "string",
            "Description": "The prefix used for all Sql databases.",
            "DefaultValue": ""
        },
        "SiteName": {
            "Type": "string",
            "DefaultValue": "Sitecore",
            "Description": "The name of the site to be deployed."
        },
        "SitecoreAdminPassword": {
            "Type": "string",
            "DefaultValue": "b",
            "Description": "The admin password for the Sitecore instance."
        },
        "SqlAdminUser": {
            "Type": "string",
            "DefaultValue": "sa",
            "Description": "The Sql admin user account to use when installing databases."
        },
        "SqlAdminPassword": {
            "Type": "string",
            "DefaultValue": "12345",
            "Description": "The Sql admin password to use when installing databases."
        },
        "SqlServer": {
            "Type": "string",
            "DefaultValue": ".\\SQLSERVER",
            "Description": "The Sql Server where databases will be installed."
        }
    },
    "Register": {
        "Tasks": {
            "MoveItem": "Move-Item"
        }
    },
    "Variables": {
        "Sql.Database.Core": "[concat(parameter('SqlDbPrefix'), '_Core')]",
        "Sql.Database.Master": "[concat(parameter('SqlDbPrefix'), '_Master')]",
        "SXA.DB.Core": "[SqlConnectionString(Server:parameter('SqlServer'),Database:variable('Sql.Database.Core'),UserName:parameter('SqlAdminUser'),Password:parameter('SqlAdminPassword'))]",
        "SXA.DB.Master": "[SqlConnectionString(Server:parameter('SqlServer'),Database:variable('Sql.Database.Master'),UserName:parameter('SqlAdminUser'),Password:parameter('SqlAdminPassword'))]",
        "Site.PhysicalPath": "[joinpath(environment('SystemDrive'), 'inetpub', 'wwwroot', parameter('SiteName'))]",
        "Site.DataFolder": "[joinpath(variable('Site.PhysicalPath'), 'App_Data')]",
        "Package.Extract.Location": "[joinpath(environment('TEMP'), concat(parameter('SiteName'), '.sxa-wdp'))]",
        "Package.Extract.Dacpac.Core": "[joinpath(variable('Package.Extract.Location'), 'core.dacpac')]",
        "Package.Extract.Dacpac.Master": "[joinpath(variable('Package.Extract.Location'), 'master.dacpac')]",
        "Transforms.Archive": "[joinpath(variable('Site.DataFolder'), 'Transforms', 'SXASCCPL.zip')]",
        "Transforms.Extract.Location": "[joinpath(environment('TEMP'), concat(parameter('SiteName'), '.sxa-transforms'))]",
        "Search.Solr.Config.Disabled": "[joinpath(variable('Site.PhysicalPath'), 'App_Config', 'Include', 'z.Foundation.Overrides', 'Sitecore.XA.Foundation.Search.Solr.config.disabled')]",
        "Search.Solr.Config": "[joinpath(variable('Site.PhysicalPath'), 'App_Config', 'Include', 'z.Foundation.Overrides', 'Sitecore.XA.Foundation.Search.Solr.config')]"
    },
    "Tasks": {
        "StopWebsite": {
            "Description": "Stops the website if it is running.",
            "Type": "ManageWebsite",
            "Params": {
                "Name": "[parameter('SiteName')]",
                "Action": "Stop"
            }
        },
        "StopAppPool": {
            "Description": "Stops the app pool if it is running.",
            "Type": "ManageAppPool",
            "Params": {
                "Name": "[parameter('SiteName')]",
                "Action": "Stop"
            }
        },
        "CleanDacpacExtractLocation": {
            "Description": "Creates (or empties) the temp folder the package is extracted to.",
            "Type": "EnsurePath",
            "Params": {
                "Clean": [ "[variable('Package.Extract.Location')]" ]
            }
        },
        "ExtractPackage": {
            "Description": "Extracts the package.",
            "Type": "Unpack",
            "Params": {
                "Source": "[resolvepath(parameter('Package'))]",
                "Destination": "[variable('Package.Extract.Location')]"
            }
        },
        "InstallCoreDacpac": {
            "Description": "Deploys core.dacpac.",
            "Type": "WebDeploy",
            "Params": {
                "Verb": "Sync",
                "Arguments": {
                    "Source": {
                        "dbDacFx": "[variable('Package.Extract.Dacpac.Core')]",
                        "ScriptDatabaseOptions": "False"
                    },
                    "Dest": {
                        "dbDacFx": "[variable('SXA.DB.Core')]",
                        "ScriptDatabaseOptions": "False"
                    }
                }
            }
        },
        "InstallMasterDacpac": {
            "Description": "Deploys master.dacpac.",
            "Type": "WebDeploy",
            "Params": {
                "Verb": "Sync",
                "Arguments": {
                    "Source": {
                        "dbDacFx": "[variable('Package.Extract.Dacpac.Master')]",
                        "ScriptDatabaseOptions": "False"
                    },
                    "Dest": {
                        "dbDacFx": "[variable('SXA.DB.Master')]",
                        "ScriptDatabaseOptions": "False"
                    }
                }
            }
        },
        "InstallWDP": {
            "Description": "Syncs the web deploy package with the website.",
            "Type": "WebDeploy",
            "Params": {
                "Verb": "Sync",
                "Arguments": {
                    "Source": {
                        "Package": "[resolvepath(parameter('Package'))]"
                    },
                    "Dest": "Auto",
                    "Skip": {
                        "ObjectName": "dbDacFx"
                    },
                    "enableRule": "DoNotDeleteRule",
                    "SetParam": [
                        { "Name": "Application Path", "Value": "[parameter('SiteName')]" },
                        { "Name": "Core Admin Connection String", "Value": "[variable('SXA.DB.Core')]" },
                        { "Name": "Master Admin Connection String", "Value": "[variable('SXA.DB.Master')]" }
                    ]
                }
            }
        },
        "CleanTransformsExtractLocation": {
            "Description": "Creates (or empties) the temp folder the transform archive is extracted to.",
            "Type": "EnsurePath",
            "Params": {
                "Clean": [ "[variable('Transforms.Extract.Location')]" ]
            }
        },
        "ExtractTransforms": {
            "Description": "Extracts the transform archive from App_Data\\Transforms.",
            "Type": "Unpack",
            "Params": {
                "Source": "[variable('Transforms.Archive')]",
                "Destination": "[variable('Transforms.Extract.Location')]"
            }
        },
        "TransformXmlDocuments": {
            "Type": "TransformXmlDoc",
            "Params": {
                "RootDirectoryPath": "[variable('Site.PhysicalPath')]",
                "XdtDirectory": "[joinpath(variable('Transforms.Extract.Location'), 'Xdts')]"
            }
        },
        "EnableSolrSearchConfig": {
            "Description": "Enables the module's Solr search configuration.",
            "Type": "MoveItem",
            "Params": {
                "Path": "[variable('Search.Solr.Config.Disabled')]",
                "Destination": "[variable('Search.Solr.Config')]",
                "Force": true
            }
        },
        "RemoveSolrCoreOverrides": {
            "Description": "Removes the master and web core overrides from the module's Solr configuration.",
            "Type": "RemoveXml",
            "Params": {
                "FilePath": "[variable('Search.Solr.Config')]",
                "Xpath": "//index[@id='sitecore_master_index' or @id='sitecore_web_index']/param[@desc='core']"
            }
        },
        "StartAppPool": {
            "Description": "Starts the app pool.",
            "Type": "ManageAppPool",
            "Params": {
                "Name": "[parameter('SiteName')]",
                "Action": "Start"
            }
        },
        "StartWebsite": {
            "Description": "Starts the website.",
            "Type": "ManageWebsite",
            "Params": {
                "Name": "[parameter('SiteName')]",
                "Action": "Start"
            }
        },
        "UpdateSolrSchema": {
            "Type": "SitecoreUrl",
            "Params": {
                "SitecoreInstanceRoot": "[concat('https://', parameter('SiteName'))]",
                "SitecoreActionPath": "sitecore/admin/PopulateManagedSchema.aspx?indexes=all",
                "UserName": "admin",
                "Password": "[parameter('SitecoreAdminPassword')]"
            }
        }
    }
}