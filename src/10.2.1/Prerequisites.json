        "URLRewrite.x86.Download": "[JoinPath(variable('Temp.Location'),'rewrite_x86_en-US.msi')]",
        "URLRewrite.x64.Download": "[JoinPath(variable('Temp.Location'),'rewrite_amd64_en-US.msi')]",
        "SQL.Clr.Types.2016.x86.Download": "[JoinPath(variable('Temp.Location'),'SQLSysClrTypes2016x86.msi')]",
        "SQL.Clr.Types.2016.x64.Download": "[JoinPath(variable('Temp.Location'),'SQLSysClrTypes2016x64.msi')]",
        "SQL.Smo.x64.Download": "[JoinPath(variable('Temp.Location'),'SharedManagementObjectsx64.msi')]",
        "SQL.Smo.x86.Download": "[JoinPath(variable('Temp.Location'),'SharedManagementObjectsx86.msi')]",
        "SQL.Clr.Types.x86.Download": "[JoinPath(variable('Temp.Location'),'SQLSysClrTypesx86.msi')]",
        "SQL.Clr.Types.x64.Download": "[JoinPath(variable('Temp.Location'),'SQLSysClrTypesx64.msi')]",
        "SQL.Dac.Framework.x86.Download": "[JoinPath(variable('Temp.Location'),'DacFrameworkx86.msi')]",
        "SQL.Dac.Framework.x64.Download": "[JoinPath(variable('Temp.Location'),'DacFrameworkx64.msi')]",
