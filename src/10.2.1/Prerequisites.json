{
    "Parameters": {
        "TempLocation": {
            "Type": "String",
            "Description": "Alternative location to save downloads. If left on the default $Env:Temp will be used.",
            "DefaultValue": "",
            "Validate": "[TestPath(variable('Temp.Location'))]"
        },
        "PSRepositoryPSGallery" : {
            "Type": "String",
            "Description": "Default PS Repository",
            "DefaultValue": "PSGallery"
        },
        "WebDeployx86Download": {
            "Type": "String",
            "Description": "Download location of Web Deploy 4.0 x86",
            "DefaultValue": "https://download.microsoft.com/download/webdeploy_x86_en-US.msi"
        },
        "WebDeployx64Download": {
            "Type": "String",
            "Description": "Download location of Web Deploy 4.0 x64",
